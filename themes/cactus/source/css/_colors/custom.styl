// Clean, modern dark theme with cool blue accents
$color-background = #0d1117          // Deep dark background (GitHub-ish)
$color-footer-mobile-1 = lighten($color-background, 2%)
$color-footer-mobile-2 = lighten($color-background, 10%)
$color-background-code = #161b22     // Slightly lighter for code blocks
$color-border = #30363d              // Subtle borders
$color-scrollbar = #484f58           // Medium gray scrollbar
$color-meta = #8b949e                // Cool gray for metadata
$color-meta-code = #8b949e
$color-link = #58a6ff                // Clean blue links
$color-text = #c9d1d9                // Soft white text
$color-accent-3 = #c9d1d9            // Light gray
$color-accent-2 = #f0f6fc            // Almost white
$color-accent-1 = #58a6ff            // Bright blue accent (titles, #)
$color-quote = #79c0ff               // Light blue for quotes
$highlight = hexo-config("highlight") || "rainbow"
